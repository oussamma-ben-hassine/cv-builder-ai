# Configuration du serveur
PORT=3000
NODE_ENV=production
APP_URL=https://cv.oussamma.tn

# Authentification SSO (OIDC)
OIDC_ISSUER=https://sso-a.oussamma.tn
OIDC_CLIENT_ID=client_cvbuilder_app
OIDC_CLIENT_SECRET=your_oidc_client_secret_here
OIDC_REDIRECT_URI=https://cv.oussamma.tn/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://cv.oussamma.tn/
SSO_SCOPES=openid profile email
SESSION_SECRET=your_secure_session_secret_here

# Passerelle IA LiteLLM
LITELLM_BASE_URL=https://ai.oussamma.tn/v1
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_MODEL=gemini/gemini-3.1-flash-lite-preview
LITELLM_TIMEOUT=60000
LITELLM_MAX_TOKENS=4096

# Base de données PostgreSQL (Optionnel, active la persistance Postgres si configuré)
# DATABASE_URL=postgresql://cvbuilder:password@cvbuilder-postgres:5432/cvbuilder

# Répertoire de persistance locale
DATA_DIR=/app/data
